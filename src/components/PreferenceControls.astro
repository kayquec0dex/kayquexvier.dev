<aside class="side-controls" aria-label="Preferências visuais e animações">
  <button class="control-button" type="button" data-theme-toggle aria-pressed="false">
    <span aria-hidden="true">◐</span>
    <span data-theme-label>Tema claro</span>
  </button>
  <button class="control-button" type="button" data-font-toggle aria-pressed="false">
    <span aria-hidden="true">Aa</span>
    <span data-font-label>Fonte mono</span>
  </button>
  <button
    class="control-button"
    type="button"
    data-motion-toggle
    aria-label="Ativar animações"
    aria-pressed="false"
  >
    <span aria-hidden="true">✳</span>
    <span data-motion-label>Ativar efeitos</span>
  </button>
</aside>
